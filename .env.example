POSTGRES_DB=blooming
POSTGRES_USER=blooming
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1

# Staging / Production Architecture Overrides (ADR-001, ADR-002)
# Staging should set ACCESS_TOKEN_EXPIRE_MINUTES=1440 for 24h sessions
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Hosted verification route for staging/production (must not be localhost)
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:1420/verify-email
ENVIRONMENT=development
LOG_LEVEL=INFO
GIT_SHA=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Web origins (dev server, hosted verification page); JSON list or comma-separated.
# The installed desktop app origins (http://tauri.localhost, tauri://localhost) are always allowed.
FRONTEND_URLS=["http://localhost:1420","http://127.0.0.1:1420"]
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Blooming
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
